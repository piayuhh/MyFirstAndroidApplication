<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/input_bg" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/input_bg" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- darker top edge = "pressed in" look -->
            <item
                android:height="20dp"
                android:gravity="top">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#00E7EAF6"
                        android:startColor="#33727EB5" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- light bottom edge -->
            <item
                android:height="14dp"
                android:gravity="bottom">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:endColor="#00FFFFFF"
                        android:startColor="#99FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
