<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                style="@style/Sis.Tile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo"
                    android:src="@drawable/ic_school"
                    app:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Student Portal"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="48dp" />

        <TextView
            style="@style/Sis.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Hey, student." />

        <TextView
            style="@style/Sis.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sign in to view your student record." />

        <LinearLayout
            style="@style/Sis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <TextView
                style="@style/Sis.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Username" />

            <EditText
                android:id="@+id/etUsername"
                style="@style/Sis.EditText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Your username"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                android:id="@+id/errUsername"
                style="@style/Sis.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Sis.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/Sis.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Your password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingEnd="64dp" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    style="@style/Sis.Tile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_eye"
                    android:contentDescription="Show or hide password"
                    android:elevation="3dp"
                    android:src="@drawable/ic_eye_off"
                    app:tint="@color/text_gray" />
            </FrameLayout>

            <TextView
                android:id="@+id/errPassword"
                style="@style/Sis.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:padding="4dp"
                android:text="Forgot password?"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                style="@style/Sis.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="Log in" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <LinearLayout
            android:id="@+id/pillRegister"
            style="@style/Sis.Tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New here? "
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create an account"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
