<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                style="@style/Sis.Tile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo"
                    android:src="@drawable/ic_school"
                    app:tint="@color/accent" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Student Portal"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Active Status Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="@color/status_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Active"
                    android:textColor="@color/status_green"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Welcome Banner Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Student Avatar Badge -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_avatar"
                android:elevation="4dp">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="ST"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcome"
                    style="@style/Sis.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hey, student."
                    android:textSize="26sp" />

                <TextView
                    style="@style/Sis.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Here is your student record."
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 1: Personal Information -->
        <LinearLayout
            style="@style/Sis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Personal"
                    android:src="@drawable/ic_person"
                    app:tint="@color/accent" />

                <TextView
                    style="@style/Sis.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Personal information"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Highlighted Student Number Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_id_badge_container"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="ID Badge"
                        android:src="@drawable/ic_id_badge"
                        app:tint="@color/accent" />

                    <TextView
                        style="@style/Sis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="STUDENT NUMBER"
                        android:textColor="@color/accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStudentNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_dark"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- Name Grid Row (First Name & Last Name Side by Side) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_info_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Sis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First name"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFirstName"
                        style="@style/Sis.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="0dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_info_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Sis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last name"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLastName"
                        style="@style/Sis.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="0dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Middle Name Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Sis.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Middle name"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMiddleName"
                    style="@style/Sis.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="0dp"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Academic Information -->
        <LinearLayout
            style="@style/Sis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Academic"
                    android:src="@drawable/ic_academic"
                    app:tint="@color/accent" />

                <TextView
                    style="@style/Sis.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Academic information"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Program Info Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Sis.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Program"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvProgram"
                    style="@style/Sis.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="0dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Specialization & Year Level Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_info_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Sis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Specialization"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSpecialization"
                        style="@style/Sis.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="0dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_info_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/Sis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Year level"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvYearLevel"
                        style="@style/Sis.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="0dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Log out Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_outline"
            android:drawableStart="@drawable/ic_logout"
            android:drawableTint="@color/accent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
